PORT=8000
NODE_ENV=development

SESSION_SECRET=

LOCAL_GOOGLE_CLIENT_ID=
LOCAL_GOOGLE_CLIENT_SECRET=

FRONTEND_URL=http://localhost:3000

# Comma-separated list of origins allowed to call the backend (CORS).
# Falls back to FRONTEND_URL when unset.
CORS_ORIGINS=http://localhost:3000

# Base URL of the Python federated service bridge (planned).
FEDERATED_URL=http://localhost:8001
FEDERATION_SHARED_SECRET=

DATABASE_URL=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini API key used for report OCR extraction (POST /patients/ocr).
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: override the Gemini model (defaults to gemini-2.5-flash)
GEMINI_MODEL=
