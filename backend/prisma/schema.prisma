generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  userId       String   @id @default(uuid()) @map("user_id") @db.Uuid
  googleId     String   @unique @map("google_id")
  email        String   @unique
  picture      String?
  role         String   @default("local")
  hospitalName String?  @map("hospital_name")
  pincode      String?
  geolocation  Json     @default("{}")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  patients Patient[]

  @@index([userId])
  @@map("users")
}

model Patient {
  patientId          String   @id @default(uuid()) @map("patient_id") @db.Uuid
  hospitalId         String   @map("hospital_id") @db.Uuid
  name               String
  age                Int
  sex                String
  contributedToRound Int?     @map("contributed_to_round")
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at")
  createdAt          DateTime @default(now()) @map("created_at")
  hospital           User           @relation(fields: [hospitalId], references: [userId], onDelete: Cascade)
  events             PatientEvent[]

  @@index([hospitalId, updatedAt])
  @@map("patients")
}

model PatientEvent {
  eventId    String   @id @default(uuid()) @map("event_id") @db.Uuid
  patientId  String   @map("patient_id") @db.Uuid
  eventType  String   @map("event_type")
  eventData  Json     @default("{}") @map("event_data")
  occurredAt DateTime @default(now()) @map("occurred_at")
  createdAt  DateTime @default(now()) @map("created_at")
  patient    Patient  @relation(fields: [patientId], references: [patientId], onDelete: Cascade)

  @@index([patientId, occurredAt])
  @@map("patient_events")
}

model Log {
  logId     String   @id @default(uuid()) @map("log_id") @db.Uuid
  nodeId    String   @map("node_id")
  timestamp DateTime @default(now())
  direction String
  round     Int
  metadata  Json     @default("{}")
  status    String
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([nodeId, round, direction])
  @@index([nodeId, round])
  @@index([status])
  @@map("logs")
}

model FederatedRound {
  roundId       String   @id @map("round_id") @db.Uuid
  round         Int      @unique
  status        String
  targetNodeIds Json     @map("target_node_ids")
  snapshot      Json
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("federated_rounds")
}